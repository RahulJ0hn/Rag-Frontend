# Base URL of the FastAPI backend.
#
# Leave EMPTY (the default) when:
#   - running locally with `npm run dev` — vite.config.js proxies
#     relative paths to http://localhost:8000 for you, or
#   - the backend serves this production build itself at its own
#     root URL (main.py mounts dist/ when it's present) — same origin,
#     no base URL needed.
#
# Set this when the frontend is deployed separately from the backend
# (e.g. frontend on Vercel/Netlify, backend on its own host/VM):
#   VITE_API_URL=https://api.your-domain.com
#
# Whatever you set here must also be added to CORS allow_origins in
# the backend's main.py, or the browser will block every request.
VITE_API_URL=
